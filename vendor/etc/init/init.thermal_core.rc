service thermal_core /vendor/bin/thermal_core
    class main
    socket thermal_socket stream 660 root system
    user root
    group system radio
    disabled

on property:vendor.all.modules.ready=1 && property:ro.vendor.mtk_thermal_2_0=1
    write /proc/bootprof "MTKPOWER:THERMAL CORE start"
    start thermal_core

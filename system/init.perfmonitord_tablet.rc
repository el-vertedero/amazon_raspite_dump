service perfmonitord /system/system_ext/bin/perfmonitord
    user root
    group system readproc
    class main

on post-fs
    insmod /vendor/lib/modules/perfinfo.ko
    chown root system /proc/perfinfo
    chmod 0660 /proc/perfinfo
